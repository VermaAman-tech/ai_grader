<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grade Review - <%= exam.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .sp-shell { display:flex; min-height:100vh; }
    .sp-sidebar { width:240px; background:var(--bg-card); border-right:1px solid var(--border); padding:1.5rem 1rem; display:flex; flex-direction:column; }
    .sp-sidebar .sp-brand { display:flex; align-items:center; gap:0.75rem; font-weight:700; font-size:1.1rem; margin-bottom:2rem; }
    .sp-sidebar nav a { display:flex; align-items:center; gap:0.5rem; padding:0.6rem 0.75rem; border-radius:8px; color:var(--text-primary); text-decoration:none; font-size:0.875rem; margin-bottom:2px; }
    .sp-sidebar nav a:hover { background:var(--bg-secondary); }
    .sp-main { flex:1; padding:2rem; overflow-y:auto; }
    .sp-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:1.25rem; margin-bottom:1rem; }
    .grade-q-card { border:1px solid var(--border); border-radius:10px; padding:1rem; margin-bottom:0.75rem; }
    .grade-marks { font-size:1.25rem; font-weight:700; }
    .grade-feedback { padding:0.75rem; background:var(--bg-secondary); border-radius:8px; margin-top:0.75rem; }
    .matched { color:var(--success); }
    .missing { color:var(--danger); }
    @media(max-width:768px) { .sp-sidebar { display:none; } .sp-main { padding:1rem; } }
  </style>
</head>
<body>
  <div class="sp-shell">
    <aside class="sp-sidebar">
      <div class="sp-brand">
        <%- include('partials/logo', { logoSize: 28, logoId: 'spg' }) %>
        <span>Student Portal</span>
      </div>
      <nav>
        <a href="/student/dashboard"><i data-lucide="layout-dashboard"></i> Dashboard</a>
        <a href="/student/course/<%= course.id %>"><i data-lucide="book-open"></i> <%= course.code %></a>
      </nav>
      <div style="margin-top:auto"><a href="/student/logout" style="display:flex;align-items:center;gap:0.5rem;color:var(--text-secondary);text-decoration:none;font-size:0.875rem"><i data-lucide="log-out"></i> Sign Out</a></div>
    </aside>

    <main class="sp-main">
      <a href="/student/course/<%= course.id %>" style="font-size:0.875rem;opacity:0.6">&larr; <%= course.code %></a>
      <h1 style="margin:0.5rem 0"><%= exam.name %></h1>

      <div class="sp-card" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
        <div>
          <div style="font-size:2rem;font-weight:700;color:<%= (totalAwarded/totalMax*100) >= 70 ? 'var(--success)' : (totalAwarded/totalMax*100) >= 40 ? 'var(--warning)' : 'var(--danger)' %>">
            <%= totalAwarded.toFixed(1) %> / <%= totalMax %>
          </div>
          <div style="font-size:1.1rem;opacity:0.7"><%= (totalAwarded / totalMax * 100).toFixed(1) %>%</div>
        </div>
        <% if (canCrib) { %>
          <div style="text-align:right">
            <span class="badge badge-warning">Crib window open</span>
            <div style="font-size:0.8rem;opacity:0.6">Until <%= cribDeadline.toLocaleString() %></div>
          </div>
        <% } %>
      </div>

      <h3 style="margin:1.5rem 0 1rem">Question-wise Breakdown</h3>
      <% grades.forEach(g => { %>
        <div class="grade-q-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
            <strong>Q<%= g.question_no %></strong>
            <div class="grade-marks" style="color:<%= (g.effectiveMarks / (g.Rubric?.max_marks || 1) * 100) >= 70 ? 'var(--success)' : (g.effectiveMarks / (g.Rubric?.max_marks || 1) * 100) >= 40 ? 'var(--warning)' : 'var(--danger)' %>">
              <%= g.effectiveMarks.toFixed(1) %> / <%= g.Rubric?.max_marks || '?' %>
            </div>
          </div>
          <small style="opacity:0.7"><%= g.Rubric?.question_text || '' %></small>

          <div class="grade-feedback">
            <strong>Feedback:</strong>
            <p style="margin:0.25rem 0"><%= g.feedback || 'No feedback available.' %></p>
          </div>

          <% if (g.parsedMatched.length > 0) { %>
            <div style="margin-top:0.5rem">
              <small class="matched"><i data-lucide="check" style="width:12px;height:12px"></i> Matched:</small>
              <% g.parsedMatched.forEach(m => { %><span class="badge badge-success" style="margin:2px"><%= m %></span><% }) %>
            </div>
          <% } %>
          <% if (g.parsedMissing.length > 0) { %>
            <div style="margin-top:0.25rem">
              <small class="missing"><i data-lucide="x" style="width:12px;height:12px"></i> Missing:</small>
              <% g.parsedMissing.forEach(m => { %><span class="badge badge-danger" style="margin:2px"><%= m %></span><% }) %>
            </div>
          <% } %>

          <% const hasCrib = existingCribs.find(c => c.question_no === g.question_no); %>
          <% if (canCrib && !hasCrib) { %>
            <details style="margin-top:0.75rem">
              <summary style="cursor:pointer;color:var(--accent);font-size:0.875rem"><i data-lucide="message-square-warning" style="width:14px;height:14px"></i> Submit Regrade Request</summary>
              <form method="POST" action="/student/crib" style="margin-top:0.5rem">
                <input type="hidden" name="grade_id" value="<%= g.id %>">
                <input type="hidden" name="exam_id" value="<%= exam.id %>">
                <input type="hidden" name="question_no" value="<%= g.question_no %>">
                <div class="form-group">
                  <textarea name="student_reasoning" class="form-control" rows="3" placeholder="Explain why you believe you deserve more marks for this question…" required></textarea>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Submit Crib</button>
              </form>
            </details>
          <% } else if (hasCrib) { %>
            <div style="margin-top:0.5rem;padding:0.5rem;border-radius:6px;background:var(--bg-secondary)">
              <small>
                <i data-lucide="message-square-warning" style="width:12px;height:12px"></i>
                Crib submitted — Status: <span class="badge badge-<%= hasCrib.status === 'pending' ? 'warning' : hasCrib.status === 'accepted' ? 'success' : 'danger' %>"><%= hasCrib.status %></span>
                <% if (hasCrib.resolved_marks != null) { %> &middot; Updated marks: <strong><%= hasCrib.resolved_marks %></strong><% } %>
              </small>
            </div>
          <% } %>
        </div>
      <% }) %>
    </main>
  </div>
  <script>
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
    lucide.createIcons();
  </script>
</body>
</html>
