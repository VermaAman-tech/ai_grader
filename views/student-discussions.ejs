<div style="margin-bottom:28px;">
  <a href="/student/course/<%= course.id %>" style="font-size:0.82rem;color:var(--muted);display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
    <i data-lucide="arrow-left" style="width:14px;height:14px;"></i> <%= course.code %>
  </a>
  <h1 style="font-family:var(--font-display);font-size:1.65rem;font-weight:800;letter-spacing:-0.02em;margin:4px 0 0;">
    <i data-lucide="messages-square" style="width:28px;height:28px;color:var(--primary-container);"></i>
    Discussions
  </h1>
  <p style="color:var(--muted);font-size:0.88rem;margin-top:4px;"><%= course.name %></p>
</div>

<% if (threads.length === 0) { %>
  <div class="sp-card">
    <div class="sp-card-body" style="padding:0;">
      <div class="sp-empty">
        <i data-lucide="messages-square"></i>
        <h3>No discussions yet</h3>
        <p>Check back later for course discussions.</p>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="sp-card">
    <div class="sp-card-body" style="padding:12px;">
      <% threads.forEach(function(t) { %>
        <a href="/student/discussion-thread/<%= t.id %>" class="sp-list-item" style="text-decoration:none;color:inherit;">
          <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:6px;">
              <% if (t.is_pinned) { %><span class="badge" style="font-size:0.62rem;">Pinned</span><% } %>
              <strong style="font-size:0.88rem;"><%= t.title %></strong>
            </div>
            <div style="font-size:0.72rem;color:var(--muted);margin-top:3px;">
              by <%= t.User ? t.User.full_name : 'Anonymous' %> &middot;
              <%= t.DiscussionPosts ? t.DiscussionPosts.length : 0 %> replies &middot;
              <%= t.view_count %> views
            </div>
          </div>
          <% if (t.is_resolved) { %>
            <span class="badge badge-success" style="font-size:0.68rem;">Resolved</span>
          <% } %>
        </a>
      <% }); %>
    </div>
  </div>
<% } %>
