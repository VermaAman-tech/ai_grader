<div class="sp-header">
  <h1><i data-lucide="layout-dashboard"></i> Dashboard</h1>
  <p class="text-muted">Welcome back, <%= session.userName %>.</p>
</div>

<div class="sp-stats">
  <div class="sp-stat">
    <div class="sp-stat-icon blue"><i data-lucide="book-open"></i></div>
    <div><div class="sp-stat-value"><%= stats.totalCourses %></div><div class="sp-stat-label">Courses</div></div>
  </div>
  <div class="sp-stat">
    <div class="sp-stat-icon purple"><i data-lucide="file-text"></i></div>
    <div><div class="sp-stat-value"><%= stats.totalExams %></div><div class="sp-stat-label">Total Exams</div></div>
  </div>
  <div class="sp-stat">
    <div class="sp-stat-icon green"><i data-lucide="check-circle"></i></div>
    <div><div class="sp-stat-value"><%= stats.gradedExams %></div><div class="sp-stat-label">Grades Available</div></div>
  </div>
  <% if (stats.taCount > 0) { %>
  <div class="sp-stat">
    <div class="sp-stat-icon teal"><i data-lucide="users-2"></i></div>
    <div><div class="sp-stat-value"><%= stats.taCount %></div><div class="sp-stat-label">TA Courses</div></div>
  </div>
  <% } %>
</div>

<% if (!enrollments.length && taAssignments.length === 0) { %>
<div class="sp-card">
  <div class="sp-card-body" style="padding:0;">
    <div class="sp-empty">
      <i data-lucide="book-open"></i>
      <h3>No courses yet</h3>
      <p>Join a course with a code from your professor to get started.</p>
      <div style="margin-top:20px;">
        <a href="/courses/join" class="btn btn-primary"><i data-lucide="log-in"></i> Join a Course</a>
      </div>
    </div>
  </div>
</div>
<% } else { %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
  <div class="sp-card">
    <div class="sp-card-header"><i data-lucide="book-open"></i> My Courses</div>
    <div class="sp-card-body">
      <% if (enrollments.length > 0) { %>
        <% enrollments.forEach(function(e) { %>
          <a href="/student/course/<%= e.course_id %>" class="sp-course-link">
            <strong><%= e.Course?.code || 'Course' %></strong> — <%= e.Course?.name || '' %>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:3px;display:flex;gap:12px;">
              <span><i data-lucide="user" style="width:13px;height:13px;display:inline;vertical-align:-2px;"></i> <%= e.Course?.User?.full_name || 'Professor' %></span>
              <% if (e.Course?.semester) { %><span><%= e.Course.semester %></span><% } %>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <p style="color:var(--muted);font-size:0.88rem;">No courses enrolled. Ask your professor for a join code.</p>
      <% } %>
    </div>
  </div>

  <div class="sp-card">
    <div class="sp-card-header"><i data-lucide="megaphone"></i> Recent Announcements</div>
    <div class="sp-card-body">
      <% if (announcements.length > 0) { %>
        <% announcements.slice(0, 5).forEach(function(a) { %>
          <div class="sp-list-item">
            <div>
              <strong style="font-size:0.88rem;"><%= a.title %></strong>
              <div style="font-size:0.75rem;color:var(--muted);margin-top:2px;"><%= a.Course?.code %> &middot; <%= new Date(a.published_at).toLocaleDateString() %></div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p style="color:var(--muted);font-size:0.88rem;">No announcements yet.</p>
      <% } %>
    </div>
  </div>
</div>

<% if (taAssignments.length > 0) { %>
<div class="sp-card" style="margin-top:20px;">
  <div class="sp-card-header"><i data-lucide="users-2"></i> Teaching Assistant Assignments</div>
  <div class="sp-card-body">
    <p style="font-size:0.82rem;color:var(--muted);margin-bottom:14px;">Click a course to open the TA panel with grading tools and analytics.</p>
    <% taAssignments.forEach(function(ta) { %>
      <a href="#" class="sp-course-link sp-ta-course-link" data-course-id="<%= ta.courseId %>" data-course-code="<%= ta.courseCode %>" data-course-name="<%= ta.courseName %>">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div>
            <strong><%= ta.courseCode %></strong> — <%= ta.courseName %>
            <div style="font-size:0.75rem;color:var(--muted);margin-top:2px;">Role: <%= ta.role === 'head_ta' ? 'Head TA' : 'Teaching Assistant' %></div>
          </div>
          <span class="sp-ta-badge"><%= ta.role === 'head_ta' ? 'Head TA' : 'TA' %></span>
        </div>
      </a>
    <% }); %>
  </div>
</div>
<% } %>

<% } %>
