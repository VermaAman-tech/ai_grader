<div style="margin-bottom:28px">
  <a href="/student/courses" style="font-size:0.82rem;color:var(--muted);display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
    <i data-lucide="arrow-left" style="width:14px;height:14px;"></i> My Courses
  </a>
  <h1 style="font-family:var(--font-display);font-size:1.65rem;font-weight:800;letter-spacing:-0.02em;margin:4px 0 0;">
    <%= course.code %> — <%= course.name %>
  </h1>
  <p style="color:var(--muted);font-size:0.88rem;margin-top:4px;">
    <i data-lucide="user" style="width:14px;height:14px;display:inline;vertical-align:-2px;"></i>
    <%= course.User?.full_name || 'Professor' %>
    <% if (course.semester) { %>&middot; <%= course.semester %><% } %>
  </p>
</div>

<% const releasedResults = examResults.filter(r => r.released && r.pct); %>
<% if (releasedResults.length > 1) { %>
  <div class="sp-card" style="margin-bottom:20px;">
    <div class="sp-card-header"><i data-lucide="trending-up"></i> Performance Timeline</div>
    <div class="sp-card-body">
      <canvas id="scoreTimeline" height="120"></canvas>
    </div>
  </div>
<% } %>

<div class="sp-card">
  <div class="sp-card-header"><i data-lucide="file-text"></i> Exams & Grades</div>
  <div class="sp-card-body">
    <% if (examResults.length === 0) { %>
      <p style="color:var(--muted);font-size:0.88rem;">No exams created for this course yet.</p>
    <% } else { %>
      <% examResults.forEach(function(r) { %>
        <div class="sp-exam-card">
          <div>
            <strong style="font-family:var(--font-display);font-weight:700;"><%= r.exam.name %></strong>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:2px;">
              <span class="badge" style="font-size:0.7rem;"><%= r.exam.exam_type %></span>
              &middot; <%= r.exam.total_marks %> marks
            </div>
          </div>
          <div style="text-align:right;display:flex;align-items:center;gap:12px;">
            <% if (r.released && r.sub) { %>
              <div>
                <div class="sp-grade-badge" style="color:<%= parseFloat(r.pct) >= 70 ? 'var(--success)' : parseFloat(r.pct) >= 40 ? 'var(--warning)' : 'var(--error)' %>">
                  <%= r.totalAwarded.toFixed(1) %> / <%= r.totalMax %>
                </div>
                <div style="font-size:0.75rem;color:var(--muted);"><%= r.pct %>%</div>
              </div>
              <a href="/student/grades/<%= r.exam.id %>" class="btn btn-sm btn-outline">View Details</a>
            <% } else if (r.sub) { %>
              <span class="badge badge-warning">Grades Pending</span>
            <% } else { %>
              <span class="badge badge-outline">No Submission</span>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<% if (announcements.length > 0) { %>
<div class="sp-card" style="margin-top:20px;">
  <div class="sp-card-header"><i data-lucide="megaphone"></i> Announcements</div>
  <div class="sp-card-body">
    <% announcements.forEach(function(a) { %>
      <div class="sp-list-item" style="flex-direction:column;align-items:flex-start;<%= a.is_pinned ? 'border-left:3px solid var(--tertiary);' : '' %>">
        <div style="display:flex;align-items:center;gap:8px;">
          <strong style="font-size:0.88rem;"><%= a.title %></strong>
          <span class="badge badge-<%= a.type === 'grade_release' ? 'success' : 'info' %>" style="font-size:0.68rem;"><%= a.type %></span>
        </div>
        <p style="margin:6px 0 0;white-space:pre-wrap;font-size:0.85rem;line-height:1.6;color:var(--on-surface-variant);"><%= a.content %></p>
        <small style="color:var(--muted);font-size:0.72rem;margin-top:4px;"><%= new Date(a.published_at || a.createdAt).toLocaleDateString() %></small>
      </div>
    <% }); %>
  </div>
</div>
<% } %>

<% if (typeof documents !== 'undefined' && documents.length > 0) { %>
<div class="sp-card" style="margin-top:20px;">
  <div class="sp-card-header"><i data-lucide="file-stack"></i> Course Documents</div>
  <div class="sp-card-body">
    <% documents.forEach(function(d) { %>
      <div class="sp-list-item">
        <div>
          <strong style="font-size:0.88rem;"><%= d.title %></strong>
          <div style="font-size:0.72rem;color:var(--muted);margin-top:2px;"><span class="badge" style="font-size:0.68rem;"><%= d.doc_type %></span> &middot; <%= new Date(d.createdAt).toLocaleDateString() %></div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
<% } %>

<% if (concepts.length > 0) { %>
<div class="sp-card" style="margin-top:20px;">
  <div class="sp-card-header"><i data-lucide="network"></i> Concepts Covered</div>
  <div class="sp-card-body">
    <div style="display:flex;flex-wrap:wrap;gap:8px;">
      <% concepts.forEach(function(c) { %>
        <span class="badge badge-outline" style="padding:6px 14px;font-size:0.82rem;"><%= c.name %></span>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<% if (typeof threads !== 'undefined' && threads.length > 0) { %>
<div class="sp-card" style="margin-top:20px;">
  <div class="sp-card-header"><i data-lucide="messages-square"></i> Recent Discussions</div>
  <div class="sp-card-body">
    <% threads.forEach(function(t) { %>
      <a href="/student/discussion-thread/<%= t.id %>" class="sp-list-item" style="text-decoration:none;color:inherit;">
        <div>
          <% if (t.is_pinned) { %><span class="badge" style="font-size:0.62rem;margin-right:4px;">Pinned</span><% } %>
          <strong style="font-size:0.88rem;"><%= t.title %></strong>
          <div style="font-size:0.72rem;color:var(--muted);margin-top:2px;">
            <%= t.DiscussionPosts ? t.DiscussionPosts.length : 0 %> replies &middot; <%= t.view_count %> views
          </div>
        </div>
        <% if (t.is_resolved) { %>
          <span class="badge badge-success" style="font-size:0.68rem;">Resolved</span>
        <% } %>
      </a>
    <% }); %>
    <div style="text-align:center;margin-top:12px;">
      <a href="/student/discussions/<%= course.id %>" class="btn btn-sm btn-outline">View All Discussions</a>
    </div>
  </div>
</div>
<% } %>

<% if (releasedResults.length > 1) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
new Chart(document.getElementById('scoreTimeline'), {
  type: 'line',
  data: {
    labels: <%- jsonForScript(releasedResults.map(r => r.exam.name)) %>,
    datasets: [{
      label: 'Score %',
      data: <%- jsonForScript(releasedResults.map(r => parseFloat(r.pct))) %>,
      borderColor: '#5b4b8a',
      backgroundColor: 'rgba(91,75,138,0.08)',
      fill: true,
      tension: 0.35,
      pointRadius: 5,
      pointBackgroundColor: '#5b4b8a',
      pointBorderColor: '#fff',
      pointBorderWidth: 2,
    }]
  },
  options: {
    scales: {
      y: { min: 0, max: 100, grid: { color: 'rgba(0,0,0,0.04)' } },
      x: { grid: { display: false } }
    },
    plugins: { legend: { display: false } }
  }
});
</script>
<% } %>
