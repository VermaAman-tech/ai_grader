<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - Intelligrade</title>
  <%- include('partials/theme-init') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .otp-toggle-link { display:inline-block; margin-top:0.75rem; font-size:0.82rem; cursor:pointer; opacity:0.6; }
    .otp-toggle-link:hover { opacity:1; }
    .otp-section { display:none; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--outline-variant); }
    .otp-section.show { display:block; }
    .join-banner { background:var(--primary-container, #e3f0ff); border:1px solid var(--primary, #4361ee); border-radius:10px; padding:0.85rem 1rem; margin-bottom:1.25rem; font-size:0.88rem; display:flex; align-items:center; gap:0.5rem; }
    .join-banner i { flex-shrink:0; width:18px; height:18px; color:var(--primary, #4361ee); }
    .links-row { display:flex; justify-content:space-between; align-items:center; margin-top:0.5rem; font-size:0.82rem; }
  </style>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { logoSize: 44, logoId: 'auth' }) %>
        <h1>Intelligrade</h1>
      </div>
      <h2>Welcome back</h2>
      <p class="auth-subtitle">Sign in to your account</p>

      <% if (typeof pendingJoin !== 'undefined' && pendingJoin) { %>
        <div class="join-banner">
          <i data-lucide="log-in"></i>
          <span>Sign in to join the course. Don't have an account? <a href="/register">Create one</a></span>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% (Array.isArray(success) ? success : [success]).forEach(function(msg) { %><div class="alert alert-success"><%= msg %></div><% }); %>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% (Array.isArray(error) ? error : [error]).forEach(function(msg) { %><div class="alert alert-error"><%= msg %></div><% }); %>
      <% } %>

      <form method="POST" action="/login" class="auth-form" id="loginForm">
        <div class="form-group">
          <label>Email</label>
          <div class="input-icon"><i data-lucide="mail"></i><input type="email" name="email" id="emailField" required placeholder="you@example.com" autocomplete="email"></div>
        </div>
        <div class="form-group">
          <label>Password</label>
          <div class="input-icon"><i data-lucide="lock"></i><input type="password" name="password" required placeholder="Enter your password" autocomplete="current-password"></div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
      </form>

      <div class="links-row">
        <a href="#" id="otpToggle" class="otp-toggle-link"><i data-lucide="mail-check" style="width:14px;height:14px;vertical-align:middle;margin-right:3px;"></i> Sign in without password</a>
        <a href="/forgot-password" style="font-size:0.82rem; opacity:0.6;">Forgot password?</a>
      </div>

      <div class="otp-section" id="otpSection">
        <p style="font-size:0.82rem; opacity:0.6; margin:0 0 0.75rem;">We'll email you a one-time code — no password needed.</p>
        <form method="POST" action="/request-otp" class="auth-form">
          <input type="hidden" name="email" id="otpEmailHidden">
          <div class="form-group" id="otpEmailGroup">
            <label>Email</label>
            <div class="input-icon"><i data-lucide="mail"></i><input type="email" name="email" id="otpEmailField" required placeholder="you@example.com" autocomplete="email"></div>
          </div>
          <button type="submit" class="btn btn-outline btn-block">Send Login Code</button>
        </form>
      </div>

      <% if (typeof ssoEnabled !== 'undefined' && (ssoEnabled.google || ssoEnabled.saml)) { %>
        <div style="display:flex;align-items:center;gap:0.75rem;margin:1.25rem 0 0.75rem;">
          <hr style="flex:1;border:none;border-top:1px solid var(--outline-variant);">
          <span style="font-size:0.78rem;opacity:0.5;">or continue with</span>
          <hr style="flex:1;border:none;border-top:1px solid var(--outline-variant);">
        </div>
        <div style="display:flex;gap:0.5rem;">
          <% if (ssoEnabled.google) { %>
            <a href="/auth/google" class="btn btn-outline btn-block" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;">
              <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59A14.5 14.5 0 019.5 24c0-1.59.28-3.14.76-4.59l-7.98-6.19A23.99 23.99 0 000 24c0 3.77.9 7.34 2.44 10.51l8.09-5.92z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
              Google
            </a>
          <% } %>
          <% if (ssoEnabled.saml) { %>
            <a href="/auth/saml" class="btn btn-outline btn-block" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;">
              <i data-lucide="building-2" style="width:18px;height:18px;"></i>
              <%= ssoEnabled.samlName %>
            </a>
          <% } %>
        </div>
      <% } %>

      <p class="auth-footer-text" style="margin-top:1.25rem;">No account? <a href="/register">Create one</a></p>
      <% if (!(typeof pendingJoin !== 'undefined' && pendingJoin)) { %>
        <p class="auth-footer-text" style="font-size:0.8rem; opacity:0.55;">Have a join code from your professor? <a href="/courses/join">Join a course</a></p>
      <% } %>
    </div>
  </div>
  <script>
    lucide.createIcons();

    const toggle = document.getElementById('otpToggle');
    const section = document.getElementById('otpSection');
    const mainEmail = document.getElementById('emailField');
    const otpEmail = document.getElementById('otpEmailField');

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      const showing = section.classList.toggle('show');
      if (showing && mainEmail.value) {
        otpEmail.value = mainEmail.value;
      }
      toggle.innerHTML = showing
        ? '<i data-lucide="lock" style="width:14px;height:14px;vertical-align:middle;margin-right:3px;"></i> Use password instead'
        : '<i data-lucide="mail-check" style="width:14px;height:14px;vertical-align:middle;margin-right:3px;"></i> Sign in without password';
      lucide.createIcons();
    });

    mainEmail.addEventListener('input', function() {
      if (section.classList.contains('show')) otpEmail.value = this.value;
    });
  </script>
</body>
</html>
