PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-64-char-string

# ─── PostgreSQL ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligrade
# Or set individually:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=intelligrade
# DB_USER=postgres
# DB_PASS=postgres
# DB_SSL=false
# DB_POOL_MAX=10
# DB_POOL_MIN=2

# ─── MongoDB (for chat / conversation storage) ───
MONGODB_URI=mongodb://localhost:27017/intelligrade
# MONGODB_DB=intelligrade
# MONGODB_POOL_SIZE=10

# ─── Hugging Face (LLM grading + vision OCR) ───
HF_TOKEN=
HF_PROVIDER=auto
HF_REASONING_TOKEN=
HF_REASONING_PROVIDER=auto

# Reasoning model config (chat/assistant)
REASONING_MODEL=Qwen/Qwen2.5-7B-Instruct
REASONING_FALLBACK_MODELS=Qwen/Qwen2.5-3B-Instruct

# Backward-compatible aliases for grading/chat paths
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_FALLBACK_MODELS=Qwen/Qwen2.5-3B-Instruct
LLM_TIMEOUT=60000
LLM_MAX_RETRIES=5

OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
OCR_TIMEOUT=90000
OCR_MIN_TEXT_CHARS=20

# ─── File Storage ───
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ─── Email / SMTP ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=founders@intelligrade.space

# ─── Stripe Payments ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Google OAuth SSO ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# ─── SAML SSO (for institutional integration) ───
SAML_ENTRY_POINT=
SAML_ISSUER=intelligrade
SAML_CERT=
SAML_CALLBACK_URL=/auth/saml/callback
SAML_IDP_NAME=Institution SSO

# ─── Development ───
DEV_OTP_EXPOSE=true

# ─── Demo seed credentials ───
DEMO_ACCOUNT_EMAIL=demo.prof@intelligrade.local
DEMO_ACCOUNT_PASSWORD=Demo@12345
