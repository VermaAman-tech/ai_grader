<div class="page-header">
  <h1><i data-lucide="file-text"></i> Exams</h1>
</div>

<div class="filter-bar">
  <form method="GET" action="/exams" class="inline-form">
    <label>Course:</label>
    <select name="course_id" onchange="this.form.submit()">
      <option value="">-- Select Course --</option>
      <% courses.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= selectedCourseId === c.id ? 'selected' : '' %>><%= c.code %> - <%= c.name %></option>
      <% }); %>
    </select>
  </form>
  <% if (selectedCourseId) { %>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('addExamModal').showModal()"><i data-lucide="plus"></i> New Exam</button>
  <% } %>
</div>

<% if (!selectedCourseId) { %>
  <div class="empty-state"><i data-lucide="file-text"></i><h3>Select a course</h3><p>Choose a course above to manage its exams.</p></div>
<% } else if (!exams.length) { %>
  <div class="empty-state"><i data-lucide="file-text"></i><h3>No exams yet</h3><p>Create an exam for this course.</p>
    <button class="btn btn-primary" onclick="document.getElementById('addExamModal').showModal()"><i data-lucide="plus"></i> New Exam</button>
  </div>
<% } else { %>
<table class="table">
  <thead><tr><th>Name</th><th>Type</th><th>Total Marks</th><th>Rubric Qs</th><th>Submissions</th><th>Released</th><th>Actions</th></tr></thead>
  <tbody>
    <% exams.forEach(function(e) { %>
      <tr>
        <td><strong><%= e.name %></strong></td>
        <td><span class="badge"><%= e.exam_type %></span></td>
        <td><%= e.total_marks %></td>
        <td><%= e.rubricCount %></td>
        <td><%= e.subCount %></td>
        <td>
          <form method="POST" action="/exams/<%= e.id %>/release-grades" style="display:inline">
            <input type="hidden" name="return_to" value="/exams?course_id=<%= selectedCourseId %>">
            <% if (e.grades_released) { %>
              <button class="btn btn-sm btn-outline" style="border-color:var(--success);color:var(--success);" title="Click to hide grades"><i data-lucide="check-circle"></i> Released</button>
            <% } else { %>
              <button class="btn btn-sm btn-outline" title="Click to release grades"><i data-lucide="lock"></i> Not released</button>
            <% } %>
          </form>
        </td>
        <td class="actions-cell">
          <a href="/rubric?exam_id=<%= e.id %>" class="btn btn-sm btn-outline">Rubric</a>
          <a href="/submissions?course_id=<%= selectedCourseId %>&exam_id=<%= e.id %>" class="btn btn-sm btn-outline">Submissions</a>
          <a href="/grading?exam_id=<%= e.id %>" class="btn btn-sm btn-outline">Grade</a>
          <form method="POST" action="/exams/<%= e.id %>/delete?course_id=<%= selectedCourseId %>" style="display:inline" onsubmit="return confirm('Delete this exam?')">
            <button class="btn btn-sm btn-danger"><i data-lucide="trash-2"></i></button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<% if (selectedCourseId) { %>
<dialog id="addExamModal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><h3>New Exam</h3><button class="modal-close" onclick="this.closest('dialog').close()">&times;</button></div>
    <form method="POST" action="/exams">
      <input type="hidden" name="course_id" value="<%= selectedCourseId %>">
      <div class="form-group"><label>Exam Name</label><input type="text" name="name" required placeholder="Midterm Exam 1"></div>
      <div class="form-row">
        <div class="form-group"><label>Type</label>
          <select name="exam_type"><option value="exam">Exam</option><option value="quiz">Quiz</option><option value="assignment">Assignment</option><option value="midterm">Midterm</option><option value="final">Final</option></select>
        </div>
        <div class="form-group"><label>Total Marks</label><input type="number" name="total_marks" value="100" min="1"></div>
      </div>
      <div class="form-group"><label>Instructions (optional)</label><textarea name="instructions" rows="3" placeholder="Special grading instructions..."></textarea></div>
      <div class="form-actions"><button type="button" class="btn btn-outline" onclick="this.closest('dialog').close()">Cancel</button><button type="submit" class="btn btn-primary">Create Exam</button></div>
    </form>
  </div>
</dialog>
<% } %>
