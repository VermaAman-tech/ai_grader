<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join a Course - Intelligrade</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { logoSize: 44, logoId: 'auth' }) %>
        <h1>Intelligrade</h1>
      </div>
      <h2>Join a course</h2>
      <p class="auth-subtitle">Enter the join code provided by your professor.</p>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% (Array.isArray(success) ? success : [success]).forEach(function(msg) { %><div class="alert alert-success"><%= msg %></div><% }); %>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% (Array.isArray(error) ? error : [error]).forEach(function(msg) { %><div class="alert alert-error"><%= msg %></div><% }); %>
      <% } %>

      <form method="POST" action="/courses/join" class="auth-form">
        <div class="form-group">
          <label>Join Code</label>
          <div class="input-icon">
            <i data-lucide="key-round"></i>
            <input type="text" name="code" required maxlength="8" placeholder="e.g. A1B2C3D4"
                   value="<%= typeof code !== 'undefined' ? code : '' %>"
                   style="letter-spacing:.2em; text-transform:uppercase; font-weight:600; font-size:1.1rem; text-align:center;">
          </div>
        </div>
        <div class="form-group">
          <label>I am joining as</label>
          <div class="form-row" style="gap:8px;">
            <label class="reg-inst-opt" style="flex:1;">
              <input type="radio" name="role" value="student" checked>
              <span>Student</span>
            </label>
            <label class="reg-inst-opt" style="flex:1;">
              <input type="radio" name="role" value="ta">
              <span>Teaching Assistant</span>
            </label>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Join Course</button>
      </form>

      <p class="auth-footer-text"><a href="/dashboard">Back to Dashboard</a></p>
    </div>
  </div>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
