<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard - Intelligrade</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .sp-shell { display:flex; min-height:100vh; }
    .sp-sidebar { width:240px; background:var(--bg-card); border-right:1px solid var(--border); padding:1.5rem 1rem; display:flex; flex-direction:column; }
    .sp-sidebar .sp-brand { display:flex; align-items:center; gap:0.75rem; font-weight:700; font-size:1.1rem; margin-bottom:2rem; }
    .sp-sidebar nav a { display:flex; align-items:center; gap:0.5rem; padding:0.6rem 0.75rem; border-radius:8px; color:var(--text-primary); text-decoration:none; font-size:0.875rem; margin-bottom:2px; }
    .sp-sidebar nav a:hover, .sp-sidebar nav a.active { background:var(--bg-secondary); }
    .sp-sidebar nav a.active { font-weight:600; color:var(--accent); }
    .sp-main { flex:1; padding:2rem; overflow-y:auto; }
    .sp-header { margin-bottom:2rem; }
    .sp-header h1 { font-size:1.5rem; margin:0; }
    .sp-header p { opacity:0.7; margin:0.25rem 0 0; }
    .sp-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; margin-bottom:2rem; }
    .sp-stat { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:1.25rem; }
    .sp-stat-label { font-size:0.75rem; opacity:0.6; text-transform:uppercase; letter-spacing:0.05em; }
    .sp-stat-value { font-size:1.75rem; font-weight:700; }
    .sp-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:1.25rem; margin-bottom:1rem; }
    .sp-card h3 { margin:0 0 1rem; font-size:1rem; }
    .sp-course-link { display:block; padding:0.75rem; border-radius:8px; text-decoration:none; color:inherit; border:1px solid var(--border); margin-bottom:0.5rem; }
    .sp-course-link:hover { background:var(--bg-secondary); }
    @media(max-width:768px) { .sp-sidebar { display:none; } .sp-main { padding:1rem; } }
  </style>
</head>
<body>
  <div class="sp-shell">
    <aside class="sp-sidebar">
      <div class="sp-brand">
        <%- include('partials/logo', { logoSize: 28, logoId: 'sp' }) %>
        <span>Student Portal</span>
      </div>
      <nav>
        <a href="/student/dashboard" class="active"><i data-lucide="layout-dashboard"></i> Dashboard</a>
        <% enrollments.forEach(e => { %>
          <a href="/student/course/<%= e.course_id %>"><i data-lucide="book-open"></i> <%= e.Course?.code || 'Course' %></a>
        <% }) %>
      </nav>
      <div style="margin-top:auto;padding-top:1rem;border-top:1px solid var(--border)">
        <a href="/student/logout" style="display:flex;align-items:center;gap:0.5rem;color:var(--text-secondary);text-decoration:none;font-size:0.875rem">
          <i data-lucide="log-out"></i> Sign Out
        </a>
      </div>
    </aside>

    <main class="sp-main">
      <div class="sp-header">
        <h1>Welcome back!</h1>
        <p>Your academic dashboard across all enrolled courses</p>
      </div>

      <div class="sp-stats">
        <div class="sp-stat"><div class="sp-stat-label">Enrolled Courses</div><div class="sp-stat-value"><%= stats.totalCourses %></div></div>
        <div class="sp-stat"><div class="sp-stat-label">Total Exams</div><div class="sp-stat-value"><%= stats.totalExams %></div></div>
        <div class="sp-stat"><div class="sp-stat-label">Grades Available</div><div class="sp-stat-value"><%= stats.gradedExams %></div></div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem">
        <div class="sp-card">
          <h3><i data-lucide="book-open" style="width:16px;height:16px"></i> My Courses</h3>
          <% if (enrollments.length > 0) { %>
            <% enrollments.forEach(e => { %>
              <a href="/student/course/<%= e.course_id %>" class="sp-course-link">
                <strong><%= e.Course?.code %></strong> — <%= e.Course?.name %>
                <div style="font-size:0.8rem;opacity:0.6"><%= e.Course?.User?.full_name || 'Professor' %> &middot; <%= e.Course?.semester || '' %></div>
              </a>
            <% }) %>
          <% } else { %>
            <p style="opacity:0.6">No course enrollments found for your email.</p>
          <% } %>
        </div>

        <div class="sp-card">
          <h3><i data-lucide="megaphone" style="width:16px;height:16px"></i> Recent Announcements</h3>
          <% if (announcements.length > 0) { %>
            <% announcements.slice(0, 5).forEach(a => { %>
              <div style="padding:0.5rem 0;border-bottom:1px solid var(--border)">
                <strong><%= a.title %></strong>
                <div style="font-size:0.8rem;opacity:0.6"><%= a.Course?.code %> &middot; <%= new Date(a.published_at).toLocaleDateString() %></div>
              </div>
            <% }) %>
          <% } else { %>
            <p style="opacity:0.6">No announcements yet.</p>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  <script>
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
    lucide.createIcons();
  </script>
</body>
</html>
