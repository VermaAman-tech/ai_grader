<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join a Course - Intelligrade</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .join-info { background:var(--surface-container-low, #f5f5f5); border-radius:12px; padding:1.25rem; margin-bottom:1.5rem; }
    .join-info h3 { margin:0 0 0.5rem; font-size:0.95rem; }
    .join-info p { margin:0; font-size:0.85rem; opacity:0.7; line-height:1.5; }
    .join-steps { list-style:none; padding:0; margin:1rem 0 0; counter-reset:step; }
    .join-steps li { counter-increment:step; display:flex; align-items:flex-start; gap:0.75rem; margin-bottom:0.75rem; font-size:0.88rem; }
    .join-steps li::before { content:counter(step); flex-shrink:0; width:24px; height:24px; border-radius:50%; background:var(--primary, #4361ee); color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; }
  </style>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { logoSize: 44, logoId: 'auth' }) %>
        <h1>Intelligrade</h1>
      </div>
      <h2>Join a course</h2>
      <p class="auth-subtitle">Enter the code your professor gave you.</p>

      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% (Array.isArray(error) ? error : [error]).forEach(function(msg) { %><div class="alert alert-error"><%= msg %></div><% }); %>
      <% } %>

      <div class="join-info">
        <h3>How it works</h3>
        <ol class="join-steps">
          <li>Enter your course join code below</li>
          <li>Sign in or create a free account</li>
          <li>You're in! Access grades, materials, and more.</li>
        </ol>
      </div>

      <form id="joinForm">
        <div class="form-group">
          <label>Join Code</label>
          <div class="input-icon">
            <i data-lucide="key-round"></i>
            <input type="text" id="joinCode" required maxlength="8" placeholder="e.g. A1B2C3D4"
                   value="<%= typeof code !== 'undefined' ? code : '' %>"
                   style="letter-spacing:.2em; text-transform:uppercase; font-weight:600; font-size:1.1rem; text-align:center;">
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Continue</button>
      </form>

      <p class="auth-footer-text" style="margin-top:1.25rem;">
        Already signed in? <a href="/login">Go to dashboard</a>
      </p>
    </div>
  </div>
  <script>
    lucide.createIcons();

    document.getElementById('joinForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const code = document.getElementById('joinCode').value.trim().toUpperCase();
      if (code) window.location.href = '/courses/join/' + encodeURIComponent(code);
    });
  </script>
</body>
</html>
