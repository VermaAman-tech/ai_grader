<div class="sp-header">
  <h1><i data-lucide="book-open"></i> My Courses</h1>
  <p class="text-muted">All courses you're enrolled in</p>
</div>

<% if (enrollments.length > 0) { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;">
    <% enrollments.forEach(function(e) { %>
      <a href="/student/course/<%= e.course_id %>" class="sp-card sp-course-link" style="padding:0;margin:0;box-shadow:var(--shadow);">
        <div style="padding:20px;">
          <div style="font-family:var(--font-display);font-size:1.05rem;font-weight:700;letter-spacing:-0.01em;margin-bottom:4px;color:var(--on-surface);">
            <%= e.Course?.code || 'Course' %>
          </div>
          <div style="font-size:0.9rem;color:var(--on-surface-variant);margin-bottom:12px;"><%= e.Course?.name || '' %></div>
          <div style="font-size:0.78rem;color:var(--muted);display:flex;gap:14px;align-items:center;">
            <span style="display:flex;align-items:center;gap:4px;"><i data-lucide="user" style="width:13px;height:13px;"></i> <%= e.Course?.User?.full_name || 'Professor' %></span>
            <% if (e.Course?.semester) { %><span class="badge" style="font-size:0.72rem;"><%= e.Course.semester %></span><% } %>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="sp-card">
    <div class="sp-card-body" style="padding:0;">
      <div class="sp-empty">
        <i data-lucide="book-open"></i>
        <h3>No courses yet</h3>
        <p>Join a course with a code from your professor.</p>
        <div style="margin-top:20px;">
          <a href="/courses/join" class="btn btn-primary"><i data-lucide="log-in"></i> Join a Course</a>
        </div>
      </div>
    </div>
  </div>
<% } %>
