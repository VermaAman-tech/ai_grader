<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TA Portal - Intelligrade</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { logoSize: 36, logoId: 'ta-login' }) %>
        <h2>TA Portal</h2>
        <p><%= mode === 'register' ? 'Create your account to start as a Teaching Assistant' : 'Sign in to manage your assigned courses' %></p>
      </div>

      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% (Array.isArray(error) ? error : [error]).forEach(function(msg) { %><div class="alert alert-error"><%= msg %></div><% }); %>
      <% } %>
      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% (Array.isArray(success) ? success : [success]).forEach(function(msg) { %><div class="alert alert-success"><%= msg %></div><% }); %>
      <% } %>

      <% if (mode === 'register') { %>
        <form method="POST" action="/ta-portal/register" class="auth-form">
          <div class="form-group">
            <label>Full Name</label>
            <div class="input-icon"><i data-lucide="user"></i><input type="text" name="full_name" required placeholder="Your full name" autocomplete="name"></div>
          </div>
          <div class="form-group">
            <label>Email (must match your TA invitation)</label>
            <div class="input-icon"><i data-lucide="mail"></i><input type="email" name="email" required placeholder="your.email@university.edu" autocomplete="email"></div>
          </div>
          <div class="form-group">
            <label>Password</label>
            <div class="input-icon"><i data-lucide="lock"></i><input type="password" name="password" required placeholder="Create a password" minlength="6" autocomplete="new-password"></div>
          </div>
          <div class="form-group">
            <label>Confirm Password</label>
            <div class="input-icon"><i data-lucide="lock"></i><input type="password" name="password_confirm" required placeholder="Confirm password" minlength="6" autocomplete="new-password"></div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Create Account</button>
        </form>
        <p class="auth-footer-text">Already have an account? <a href="/login?role=ta">Sign in</a></p>
      <% } else { %>
        <form method="POST" action="/ta-portal/login" class="auth-form">
          <div class="form-group">
            <label>Email</label>
            <div class="input-icon"><i data-lucide="mail"></i><input type="email" name="email" required placeholder="your.email@university.edu" autocomplete="email"></div>
          </div>
          <div class="form-group">
            <label>Password</label>
            <div class="input-icon"><i data-lucide="lock"></i><input type="password" name="password" required placeholder="Enter your password" autocomplete="current-password"></div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Sign In</button>
        </form>
        <p class="auth-footer-text">Invited as TA but no account? <a href="/ta-portal/register">Register here</a></p>
      <% } %>

      <div style="text-align:center;margin-top:1.5rem">
        <a href="/login" style="opacity:0.7;font-size:0.875rem">Sign in</a>
        &middot;
        <a href="/" style="opacity:0.7;font-size:0.875rem">Home</a>
      </div>
    </div>
  </div>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
