  <script>
    lucide.createIcons();

    /* ── Theme ── */
    document.getElementById('lnThemeToggle').addEventListener('click', () => {
      const c = document.documentElement.getAttribute('data-theme');
      const n = c === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', n);
      localStorage.setItem('ig-theme', n);
    });

    /* ── Mobile nav ── */
    document.getElementById('lnHamburger').addEventListener('click', () => {
      document.getElementById('lnLinks').classList.toggle('open');
    });
    document.querySelectorAll('#lnLinks a[href^="#"]').forEach(a => {
      a.addEventListener('click', () => document.getElementById('lnLinks').classList.remove('open'));
    });

    /* ── Nav scroll effect ── */
    window.addEventListener('scroll', () => {
      document.getElementById('lnNav').classList.toggle('scrolled', window.scrollY > 40);
    });

    /* ── Currency ── */
    function switchCurrency(c, e) {
      document.querySelectorAll('.ln-cur-btn').forEach(b => b.classList.remove('active'));
      e.target.closest('.ln-cur-btn').classList.add('active');
      document.querySelectorAll('.price-switch').forEach(el => { el.textContent = el.dataset[c]; });
    }

    /* ── Feature Carousel ── */
    (function() {
      const track = document.getElementById('featureCarousel');
      const cards = track.querySelectorAll('.ln-fcard');
      const dotsWrap = document.getElementById('carouselDots');
      const prevBtn = document.getElementById('carouselPrev');
      const nextBtn = document.getElementById('carouselNext');

      function getVisible() {
        const w = window.innerWidth;
        if (w >= 1024) return 4;
        if (w >= 768) return 3;
        if (w >= 500) return 2;
        return 1;
      }

      let page = 0;
      function totalPages() { return Math.ceil(cards.length / getVisible()); }

      function buildDots() {
        dotsWrap.innerHTML = '';
        const tp = totalPages();
        for (let i = 0; i < tp; i++) {
          const d = document.createElement('button');
          d.className = 'ln-dot' + (i === page ? ' active' : '');
          d.addEventListener('click', () => { page = i; scroll(); });
          dotsWrap.appendChild(d);
        }
      }

      function scroll() {
        const vis = getVisible();
        const cardW = cards[0].offsetWidth + 20;
        const offset = page * vis * cardW;
        track.style.transform = 'translateX(-' + offset + 'px)';
        dotsWrap.querySelectorAll('.ln-dot').forEach((d, i) => d.classList.toggle('active', i === page));
      }

      prevBtn.addEventListener('click', () => { page = Math.max(0, page - 1); scroll(); });
      nextBtn.addEventListener('click', () => { page = Math.min(totalPages() - 1, page + 1); scroll(); });

      buildDots();
      window.addEventListener('resize', () => {
        page = Math.min(page, totalPages() - 1);
        buildDots();
        scroll();
      });

      /* Touch swipe */
      let startX = 0;
      track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', e => {
        const diff = startX - e.changedTouches[0].clientX;
        if (diff > 50) { page = Math.min(totalPages() - 1, page + 1); scroll(); }
        else if (diff < -50) { page = Math.max(0, page - 1); scroll(); }
      }, { passive: true });
    })();
  </script>
</body>
</html>
