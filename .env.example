PORT=4000
SESSION_SECRET=change-this-to-a-random-64-char-string
DATABASE_PATH=./data/intelligrade.db

# Hugging Face (for LLM grading + vision OCR)
HF_TOKEN=
HF_PROVIDER=auto
HF_REASONING_TOKEN=
HF_REASONING_PROVIDER=auto

# Reasoning model config (chat/assistant)
REASONING_MODEL=Qwen/Qwen2.5-7B-Instruct
REASONING_FALLBACK_MODELS=Qwen/Qwen2.5-3B-Instruct

# Backward-compatible aliases still used by grading/chat paths
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_FALLBACK_MODELS=Qwen/Qwen2.5-3B-Instruct
LLM_TIMEOUT=60000
LLM_MAX_RETRIES=5

OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
OCR_TIMEOUT=90000
OCR_MIN_TEXT_CHARS=20

UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# Optional: demo seed credentials
DEMO_ACCOUNT_EMAIL=demo.prof@intelligrade.local
DEMO_ACCOUNT_PASSWORD=Demo@12345
