<div class="page-header">
  <h1><i data-lucide="upload"></i> Submissions</h1>
</div>

<div class="filter-bar">
  <form method="GET" action="/submissions" class="inline-form" id="subFilterForm">
    <label>Course:</label>
    <select name="course_id" id="subCourse" onchange="document.getElementById('subExam').value=''; this.form.submit()">
      <option value="">-- Select Course --</option>
      <% courses.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= selectedCourseId === c.id ? 'selected' : '' %>><%= c.code %> - <%= c.name %></option>
      <% }); %>
    </select>
    <% if (selectedCourseId) { %>
      <label>Exam:</label>
      <select name="exam_id" id="subExam" onchange="this.form.submit()">
        <option value="">-- Select Exam --</option>
        <% exams.forEach(function(e) { %>
          <option value="<%= e.id %>" <%= selectedExamId === e.id ? 'selected' : '' %>><%= e.name %></option>
        <% }); %>
      </select>
    <% } %>
  </form>
  <% if (selectedExamId) { %>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('uploadSubModal').showModal()"><i data-lucide="upload"></i> Upload PDFs</button>
  <% } %>
</div>

<% if (!selectedCourseId) { %>
  <div class="empty-state"><i data-lucide="upload"></i><h3>Select a course and exam</h3><p>Choose a course and exam to manage PDF submissions.</p></div>
<% } else if (!selectedExamId) { %>
  <div class="empty-state"><i data-lucide="file-text"></i><h3>Select an exam</h3><p>Choose an exam to view submissions.</p></div>
<% } else if (!submissions.length) { %>
  <div class="empty-state"><i data-lucide="upload"></i><h3>No submissions yet</h3><p>Upload student answer PDFs to begin grading.</p>
    <button class="btn btn-primary" onclick="document.getElementById('uploadSubModal').showModal()"><i data-lucide="upload"></i> Upload PDFs</button>
  </div>
<% } else { %>
<div class="card">
  <div class="card-header"><i data-lucide="files"></i> <%= submissions.length %> Submissions</div>
  <div class="card-body">
    <table class="table">
      <thead><tr><th>Student</th><th>File</th><th>Status</th><th>Pages</th><th>Uploaded</th><th></th></tr></thead>
      <tbody>
        <% submissions.forEach(function(s) { %>
          <tr>
            <td><%= s.Student?.name || 'Unknown' %></td>
            <td><%= s.file_name %></td>
            <td><span class="status-badge status-<%= s.status %>"><%= s.status %></span></td>
            <td><%= s.page_count || '-' %></td>
            <td><%= new Date(s.created_at).toLocaleDateString() %></td>
            <td>
              <form method="POST" action="/submissions/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Delete?')">
                <button class="btn btn-sm btn-danger"><i data-lucide="trash-2"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (selectedExamId) { %>
<dialog id="uploadSubModal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><h3>Upload Submissions</h3><button class="modal-close" onclick="this.closest('dialog').close()">&times;</button></div>
    <form method="POST" action="/submissions/upload?course_id=<%= selectedCourseId %>" enctype="multipart/form-data" id="uploadForm">
      <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
      <div class="form-group">
        <label>Assign to Student</label>
        <select name="student_ids" required>
          <option value="">-- Select Student --</option>
          <% students.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.name %> (<%= s.roll_number || 'N/A' %>)</option>
          <% }); %>
        </select>
        <small class="form-hint">Select the student this PDF belongs to. Upload one file per student.</small>
      </div>
      <div class="form-group">
        <label>PDF Files</label>
        <input type="file" name="pdf_files" accept=".pdf" required multiple>
      </div>
      <div class="form-actions"><button type="button" class="btn btn-outline" onclick="this.closest('dialog').close()">Cancel</button><button type="submit" class="btn btn-primary">Upload</button></div>
    </form>
  </div>
</dialog>
<% } %>
