<div style="margin-bottom:28px;">
  <a href="/student/course/<%= course.id %>" style="font-size:0.82rem;color:var(--muted);display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
    <i data-lucide="arrow-left" style="width:14px;height:14px;"></i> <%= course.code %>
  </a>
  <h1 style="font-family:var(--font-display);font-size:1.65rem;font-weight:800;letter-spacing:-0.02em;margin:4px 0 0;">
    <i data-lucide="file-text" style="width:28px;height:28px;color:var(--primary-container);"></i>
    <%= exam.name %>
  </h1>
</div>

<!-- Score summary card -->
<div class="sp-card" style="margin-bottom:20px;">
  <div class="sp-card-body" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
    <div>
      <div style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;letter-spacing:-0.03em;color:<%= (totalAwarded/totalMax*100) >= 70 ? 'var(--success)' : (totalAwarded/totalMax*100) >= 40 ? 'var(--warning)' : 'var(--error)' %>;">
        <%= totalAwarded.toFixed(1) %> / <%= totalMax %>
      </div>
      <div style="font-size:1.05rem;color:var(--muted);font-weight:600;"><%= (totalAwarded / totalMax * 100).toFixed(1) %>%</div>
    </div>
    <% if (canCrib) { %>
      <div style="text-align:right;">
        <span class="badge badge-warning" style="padding:6px 14px;font-size:0.78rem;">Crib window open</span>
        <div style="font-size:0.75rem;color:var(--muted);margin-top:4px;">Until <%= cribDeadline.toLocaleString() %></div>
      </div>
    <% } %>
  </div>
</div>

<div class="sp-card">
  <div class="sp-card-header"><i data-lucide="list-checks"></i> Question-wise Breakdown</div>
  <div class="sp-card-body">
    <% grades.forEach(function(g) { %>
      <div class="grade-q-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <strong style="font-family:var(--font-display);font-size:0.95rem;">Q<%= g.question_no %></strong>
          <div class="grade-marks" style="color:<%= (g.effectiveMarks / (g.Rubric?.max_marks || 1) * 100) >= 70 ? 'var(--success)' : (g.effectiveMarks / (g.Rubric?.max_marks || 1) * 100) >= 40 ? 'var(--warning)' : 'var(--error)' %>">
            <%= g.effectiveMarks.toFixed(1) %> / <%= g.Rubric?.max_marks || '?' %>
          </div>
        </div>

        <% if (g.Rubric?.question_text) { %>
          <p style="font-size:0.82rem;color:var(--muted);line-height:1.5;margin-bottom:8px;"><%= g.Rubric.question_text %></p>
        <% } %>

        <div class="grade-feedback">
          <strong style="font-size:0.82rem;">Feedback</strong>
          <p style="margin:4px 0 0;font-size:0.85rem;"><%= g.feedback || 'No feedback available.' %></p>
        </div>

        <% if (g.parsedMatched.length > 0) { %>
          <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;">
            <small class="matched" style="font-weight:600;display:flex;align-items:center;gap:2px;margin-right:4px;"><i data-lucide="check" style="width:12px;height:12px;"></i> Matched:</small>
            <% g.parsedMatched.forEach(function(m) { %><span class="badge badge-success" style="font-size:0.72rem;"><%= m %></span><% }); %>
          </div>
        <% } %>
        <% if (g.parsedMissing.length > 0) { %>
          <div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;">
            <small class="missing" style="font-weight:600;display:flex;align-items:center;gap:2px;margin-right:4px;"><i data-lucide="x" style="width:12px;height:12px;"></i> Missing:</small>
            <% g.parsedMissing.forEach(function(m) { %><span class="badge badge-danger" style="font-size:0.72rem;"><%= m %></span><% }); %>
          </div>
        <% } %>

        <% if (g.concepts && g.concepts.length > 0) { %>
          <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:4px;">
            <% g.concepts.forEach(function(c) { %><span class="badge badge-info" style="font-size:0.68rem;"><%= c %></span><% }); %>
          </div>
        <% } %>

        <% const hasCrib = existingCribs.find(c => c.question_no === g.question_no); %>
        <% if (canCrib && !hasCrib) { %>
          <details style="margin-top:12px;">
            <summary style="cursor:pointer;color:var(--tertiary);font-size:0.82rem;font-weight:600;display:flex;align-items:center;gap:4px;">
              <i data-lucide="message-square-warning" style="width:14px;height:14px;"></i> Submit Regrade Request
            </summary>
            <form method="POST" action="/student/crib" style="margin-top:10px;">
              <input type="hidden" name="grade_id" value="<%= g.id %>">
              <input type="hidden" name="exam_id" value="<%= exam.id %>">
              <input type="hidden" name="question_no" value="<%= g.question_no %>">
              <div class="form-group">
                <textarea name="student_reasoning" class="form-control" rows="3" placeholder="Explain why you believe you deserve more marks..." required></textarea>
              </div>
              <button type="submit" class="btn btn-sm btn-primary">Submit Crib</button>
            </form>
          </details>
        <% } else if (hasCrib) { %>
          <div style="margin-top:10px;padding:10px 14px;border-radius:var(--radius);background:var(--surface-container);">
            <small style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="message-square-warning" style="width:13px;height:13px;"></i>
              Crib submitted —
              <span class="badge badge-<%= hasCrib.status === 'pending' ? 'warning' : hasCrib.status === 'accepted' ? 'success' : 'danger' %>" style="font-size:0.68rem;"><%= hasCrib.status %></span>
              <% if (hasCrib.resolved_marks != null) { %>&middot; Updated: <strong><%= hasCrib.resolved_marks %></strong><% } %>
            </small>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>
