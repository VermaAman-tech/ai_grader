<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.code %> - Student Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .sp-shell { display:flex; min-height:100vh; }
    .sp-sidebar { width:240px; background:var(--bg-card); border-right:1px solid var(--border); padding:1.5rem 1rem; display:flex; flex-direction:column; }
    .sp-sidebar .sp-brand { display:flex; align-items:center; gap:0.75rem; font-weight:700; font-size:1.1rem; margin-bottom:2rem; }
    .sp-sidebar nav a { display:flex; align-items:center; gap:0.5rem; padding:0.6rem 0.75rem; border-radius:8px; color:var(--text-primary); text-decoration:none; font-size:0.875rem; margin-bottom:2px; }
    .sp-sidebar nav a:hover, .sp-sidebar nav a.active { background:var(--bg-secondary); }
    .sp-main { flex:1; padding:2rem; overflow-y:auto; }
    .sp-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:1.25rem; margin-bottom:1rem; }
    .sp-exam-card { display:flex; justify-content:space-between; align-items:center; padding:1rem; border:1px solid var(--border); border-radius:10px; margin-bottom:0.5rem; gap:1rem; flex-wrap:wrap; }
    .sp-grade-badge { font-size:1.5rem; font-weight:700; }
    @media(max-width:768px) { .sp-sidebar { display:none; } .sp-main { padding:1rem; } }
  </style>
</head>
<body>
  <div class="sp-shell">
    <aside class="sp-sidebar">
      <div class="sp-brand">
        <%- include('partials/logo', { logoSize: 28, logoId: 'spc' }) %>
        <span>Student Portal</span>
      </div>
      <nav>
        <a href="/student/dashboard"><i data-lucide="layout-dashboard"></i> Dashboard</a>
        <a href="/student/course/<%= course.id %>" class="active"><i data-lucide="book-open"></i> <%= course.code %></a>
      </nav>
      <div style="margin-top:auto;padding-top:1rem;border-top:1px solid var(--border)">
        <a href="/student/logout" style="display:flex;align-items:center;gap:0.5rem;color:var(--text-secondary);text-decoration:none;font-size:0.875rem"><i data-lucide="log-out"></i> Sign Out</a>
      </div>
    </aside>

    <main class="sp-main">
      <div style="margin-bottom:2rem">
        <a href="/student/dashboard" style="font-size:0.875rem;opacity:0.6">&larr; Dashboard</a>
        <h1 style="margin:0.5rem 0 0"><%= course.code %> — <%= course.name %></h1>
        <p style="opacity:0.7"><%= course.User?.full_name || 'Professor' %> &middot; <%= course.semester || '' %></p>
      </div>

      <!-- Score Timeline Chart -->
      <% const releasedResults = examResults.filter(r => r.released && r.pct); %>
      <% if (releasedResults.length > 1) { %>
        <div class="sp-card">
          <h3><i data-lucide="trending-up" style="width:16px;height:16px"></i> Performance Timeline</h3>
          <canvas id="scoreTimeline" height="120"></canvas>
        </div>
      <% } %>

      <h3 style="margin:1.5rem 0 1rem">Exams & Grades</h3>
      <% examResults.forEach(r => { %>
        <div class="sp-exam-card">
          <div>
            <strong><%= r.exam.name %></strong>
            <div style="font-size:0.8rem;opacity:0.6"><%= r.exam.exam_type %> &middot; <%= r.exam.total_marks %> marks</div>
          </div>
          <div style="text-align:right">
            <% if (r.released && r.sub) { %>
              <div class="sp-grade-badge" style="color:<%= parseFloat(r.pct) >= 70 ? 'var(--success)' : parseFloat(r.pct) >= 40 ? 'var(--warning)' : 'var(--danger)' %>">
                <%= r.totalAwarded.toFixed(1) %> / <%= r.totalMax %>
              </div>
              <small><%= r.pct %>%</small>
              <a href="/student/grades/<%= r.exam.id %>" class="btn btn-sm btn-outline" style="margin-left:0.5rem">View Details</a>
            <% } else if (r.sub) { %>
              <span class="badge badge-warning">Submitted — Grades Pending</span>
            <% } else { %>
              <span class="badge badge-outline">No Submission</span>
            <% } %>
          </div>
        </div>
      <% }) %>

      <!-- Announcements -->
      <% if (announcements.length > 0) { %>
        <h3 style="margin:1.5rem 0 1rem">Announcements</h3>
        <% announcements.forEach(a => { %>
          <div class="sp-card" style="<%= a.is_pinned ? 'border-left:3px solid var(--accent)' : '' %>">
            <strong><%= a.title %></strong>
            <span class="badge badge-<%= a.type === 'grade_release' ? 'success' : 'info' %>" style="margin-left:0.5rem"><%= a.type %></span>
            <p style="margin:0.5rem 0 0;white-space:pre-wrap"><%= a.content %></p>
            <small style="opacity:0.6"><%= new Date(a.published_at || a.createdAt).toLocaleDateString() %></small>
          </div>
        <% }) %>
      <% } %>

      <!-- Concept Mastery -->
      <% if (concepts.length > 0) { %>
        <h3 style="margin:1.5rem 0 1rem">Concepts Covered</h3>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
          <% concepts.forEach(c => { %>
            <span class="badge badge-outline" style="padding:0.5rem 0.75rem"><%= c.name %></span>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
  <script>
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
    lucide.createIcons();

    <% if (releasedResults.length > 1) { %>
    new Chart(document.getElementById('scoreTimeline'), {
      type: 'line',
      data: {
        labels: <%- jsonForScript(releasedResults.map(r => r.exam.name)) %>,
        datasets: [{
          label: 'Score %',
          data: <%- jsonForScript(releasedResults.map(r => parseFloat(r.pct))) %>,
          borderColor: '#6C5CE7',
          backgroundColor: 'rgba(108,92,231,0.1)',
          fill: true,
          tension: 0.3,
          pointRadius: 6,
          pointBackgroundColor: '#6C5CE7',
        }]
      },
      options: { scales: { y: { min: 0, max: 100 } }, plugins: { legend: { display: false } } }
    });
    <% } %>
  </script>
</body>
</html>
