<div class="page-header">
  <h1><i data-lucide="upload"></i> Submissions</h1>
</div>

<div class="filter-bar">
  <form method="GET" action="/submissions" class="inline-form" id="subFilterForm">
    <label>Course:</label>
    <select name="course_id" id="subCourse" onchange="document.getElementById('subExam').value=''; this.form.submit()">
      <option value="">-- Select Course --</option>
      <% courses.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= selectedCourseId === c.id ? 'selected' : '' %>><%= c.code %> - <%= c.name %></option>
      <% }); %>
    </select>
    <% if (selectedCourseId) { %>
      <label>Exam:</label>
      <select name="exam_id" id="subExam" onchange="this.form.submit()">
        <option value="">-- Select Exam --</option>
        <% exams.forEach(function(e) { %>
          <option value="<%= e.id %>" <%= selectedExamId === e.id ? 'selected' : '' %>><%= e.name %></option>
        <% }); %>
      </select>
    <% } %>
  </form>
  <% if (selectedExamId) { %>
    <div style="display:flex;gap:6px;">
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('uploadSubModal').showModal()"><i data-lucide="upload"></i> Upload PDFs</button>
      <button class="btn btn-outline btn-sm" onclick="document.getElementById('zipUploadModal').showModal()"><i data-lucide="file-archive"></i> Upload ZIP</button>
    </div>
  <% } %>
</div>

<% if (typeof turnitinActive !== 'undefined' && turnitinActive) { %>
  <div class="card" style="padding:0.6rem 1rem;margin-bottom:0.75rem;display:flex;align-items:center;gap:0.5rem;border-left:3px solid #2b5797;font-size:0.85rem">
    <i data-lucide="shield-check" style="width:16px;height:16px;color:#2b5797"></i>
    <strong>Turnitin</strong> plagiarism detection is active — use the <i data-lucide="shield-check" style="width:12px;height:12px;display:inline-block;vertical-align:middle"></i> button on each submission.
  </div>
<% } %>
<% if (typeof gradescopeActive !== 'undefined' && gradescopeActive) { %>
  <div class="card" style="padding:0.6rem 1rem;margin-bottom:0.75rem;display:flex;align-items:center;gap:0.5rem;border-left:3px solid #00b0ff;font-size:0.85rem">
    <i data-lucide="clipboard-check" style="width:16px;height:16px;color:#00b0ff"></i>
    <strong>Gradescope</strong> is connected — grades will auto-sync.
  </div>
<% } %>

<% if (!selectedCourseId) { %>
  <div class="empty-state"><i data-lucide="upload"></i><h3>Select a course and exam</h3><p>Choose a course and exam to manage PDF submissions.</p></div>
<% } else if (!selectedExamId) { %>
  <div class="empty-state"><i data-lucide="file-text"></i><h3>Select an exam</h3><p>Choose an exam to view submissions.</p></div>
<% } else if (!submissions.length) { %>
  <div class="empty-state"><i data-lucide="upload"></i><h3>No submissions yet</h3><p>Upload student answer PDFs to begin grading.</p>
    <button class="btn btn-primary" onclick="document.getElementById('uploadSubModal').showModal()"><i data-lucide="upload"></i> Upload PDFs</button>
  </div>
<% } else { %>
<div class="card">
  <div class="card-header"><i data-lucide="files"></i> <%= submissions.length %> Submissions</div>
  <div class="card-body">
    <table class="table">
      <thead><tr><th>Student</th><th>File</th><th>Status</th><th>Pages</th><th>Uploaded</th><th></th></tr></thead>
      <tbody>
        <% submissions.forEach(function(s) { %>
          <tr>
            <td><%= s.Student?.name || 'Unknown' %></td>
            <td><%= s.file_name %></td>
            <td><span class="status-badge status-<%= s.status %>"><%= s.status %></span></td>
            <td><%= s.page_count || '-' %></td>
            <td><%= new Date(s.created_at).toLocaleDateString() %></td>
            <td style="display:flex;gap:4px;align-items:center">
              <% if (typeof turnitinActive !== 'undefined' && turnitinActive) { %>
                <form method="POST" action="/integrations/turnitin/check" style="display:inline">
                  <input type="hidden" name="submission_id" value="<%= s.id %>">
                  <button class="btn btn-sm btn-outline" title="Turnitin plagiarism check" style="padding:3px 6px"><i data-lucide="shield-check" style="width:14px;height:14px;color:#2b5797"></i></button>
                </form>
              <% } %>
              <form method="POST" action="/submissions/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Delete?')">
                <button class="btn btn-sm btn-danger"><i data-lucide="trash-2"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (selectedExamId) { %>
<dialog id="uploadSubModal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><h3>Upload Submissions</h3><button class="modal-close" onclick="this.closest('dialog').close()">&times;</button></div>
    <form method="POST" action="/submissions/upload?course_id=<%= selectedCourseId %>" enctype="multipart/form-data" id="uploadForm">
      <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
      <div class="form-group">
        <label>Assign to Student</label>
        <select name="student_ids" required>
          <option value="">-- Select Student --</option>
          <% students.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.name %> (<%= s.roll_number || 'N/A' %>)</option>
          <% }); %>
        </select>
        <small class="form-hint">Select the student this PDF belongs to. Upload one file per student.</small>
      </div>
      <div class="form-group">
        <label>PDF Files</label>
        <input type="file" name="pdf_files" accept=".pdf" required multiple>
      </div>
      <div class="form-actions"><button type="button" class="btn btn-outline" onclick="this.closest('dialog').close()">Cancel</button><button type="submit" class="btn btn-primary">Upload</button></div>
    </form>
  </div>
</dialog>

<dialog id="zipUploadModal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><h3><i data-lucide="file-archive"></i> Batch Upload (ZIP)</h3><button class="modal-close" onclick="this.closest('dialog').close()">&times;</button></div>
    <form method="POST" action="/submissions/upload-zip" enctype="multipart/form-data">
      <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
      <div class="form-group">
        <label>ZIP File</label>
        <input type="file" name="zip_file" accept=".zip" required>
        <small class="form-hint">Upload a ZIP file containing student answer PDFs. Files should be named by roll number (e.g., CS2023001.pdf). The system will auto-match files to students in the roster.</small>
      </div>
      <div class="form-actions"><button type="button" class="btn btn-outline" onclick="this.closest('dialog').close()">Cancel</button><button type="submit" class="btn btn-primary"><i data-lucide="upload"></i> Process ZIP</button></div>
    </form>
  </div>
</dialog>
<% } %>
