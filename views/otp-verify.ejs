<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enter Login Code - Intelligrade</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { logoSize: 44, logoId: 'auth' }) %>
        <h1>Intelligrade</h1>
      </div>
      <h2>Enter your login code</h2>
      <p class="auth-subtitle">We sent a 6-digit code to <strong><%= email %></strong></p>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% (Array.isArray(success) ? success : [success]).forEach(function(msg) { %><div class="alert alert-success"><%= msg %></div><% }); %>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% (Array.isArray(error) ? error : [error]).forEach(function(msg) { %><div class="alert alert-error"><%= msg %></div><% }); %>
      <% } %>

      <% if (mockOTP) { %>
        <div class="alert alert-info" style="background: var(--primary-container, #e8edf5); border: 1px solid var(--primary, #4361ee); border-radius: 10px; padding: 14px 18px; margin-bottom: 18px; text-align: center;">
          <small style="display:block; opacity:.7; margin-bottom:4px;">DEV MODE — Your code:</small>
          <span style="font-size: 2rem; font-weight: 700; letter-spacing: .35em; font-family: 'JetBrains Mono', monospace; color: var(--primary, #4361ee);"><%= mockOTP %></span>
        </div>
      <% } %>

      <form method="POST" action="/verify-login-otp" class="auth-form">
        <div class="form-group">
          <label>6-digit code</label>
          <div class="input-icon">
            <i data-lucide="key-round"></i>
            <input type="text" name="otp" required maxlength="6" minlength="6" placeholder="000000"
                   style="letter-spacing: .4em; text-align: center; font-size: 1.3rem; font-family: 'JetBrains Mono', monospace;"
                   autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}">
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Verify &amp; Sign In</button>
      </form>

      <p class="auth-footer-text" style="margin-top:16px;">
        <a href="/login">Use a different email</a>
      </p>
    </div>
  </div>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
